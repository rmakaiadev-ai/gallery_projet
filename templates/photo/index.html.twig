{% extends 'base.html.twig' %}

{% block title %}FocusGallery{% endblock %}

{% block body %}
<!-- FILTRES -->
<div class="filters">
    <a href="{{ path('app_photo') }}" 
       class="btn {{ currentCategory is null ? 'active' : '' }}"
       style="background-color: darkgrey; color: whitesmoke">
        Tous
    </a>

    {% for category in categories %}
    <a href="{{ path('app_photo', {category: category.id}) }}" 
       style="background-color: {{ category.color }}; color: whitesmoke" 
       class="btn {{ currentCategory == category.id ? 'active' : '' }}">
        {{ category.name }}
    </a>
    {% endfor %}
</div>

<div class="gallery">

    {% for photo in photos %}
    <div class="card">

        <img src="/uploads/photo/{{ photo.imageName }}" alt="{{ photo.title }}">

        <div class="card-content">
            <h3>{{ photo.title }}</h3>

            <div class="card-footer">
                {% if photo.category %}
                <span class="tag" style="background-color: {{ photo.category.color }}">
                    {{ photo.category.name }}
                </span>
                {% endif %}

                <a href="{{path('app_show',{id:photo.id})}}" class="btn">Voir</a>
            </div>
        </div>

    </div>
    {% endfor %}

</div>
{% endblock %}